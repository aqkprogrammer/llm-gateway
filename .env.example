# Copy to .env and adjust. Docker Compose and `make dev` both read this file.

# --- Gateway ----------------------------------------------------------------------------
# Master key for the /admin API. Generate one with: openssl rand -hex 24
GATEWAY_MASTER_KEY=sk-master-change-me
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_JSON=true
# Local defaults (Compose overrides these to point at its own services).
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
GATEWAY_CONFIG_PATH=config/gateway.yaml
# Postgres instead of SQLite (install the `postgres` extra):
# GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# --- Tracing ----------------------------------------------------------------------------
GATEWAY_OTEL_ENABLED=false
GATEWAY_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Providers (leave empty to disable; mock providers always work) ----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# --- Demo knobs -------------------------------------------------------------------------
MOCK_FLAKY_FAILURE_RATE=1.0
MOCK_CHAOS_FAILURE_RATE=0.3

# --- Host ports used by docker-compose ----------------------------------------------------
GATEWAY_HOST_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
